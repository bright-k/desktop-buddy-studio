{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Buddy Preview",
  "version": "0.1.0",
  "identifier": "io.desktopbuddy.preview",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["overlay", "settings", "timer", "timer-badge", "timer-quick"],
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": { "default-src": "'self'", "script-src": "'self'", "style-src": "'self'", "img-src": "'self' asset: http://asset.localhost", "media-src": "'self' asset: http://asset.localhost", "connect-src": "ipc: http://ipc.localhost", "object-src": "'none'", "frame-src": "'none'", "base-uri": "'none'", "form-action": "'none'" }
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": ["icons/icon.png"], "macOS": { "minimumSystemVersion": "15.0", "signingIdentity": "-" } }
}
